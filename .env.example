LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Production dispatch name. Leave as "receptionist" unless your LiveKit
# dispatch rule uses a different roomConfig.agents[].agentName. Set to an
# empty value only for local wildcard/dev dispatch testing.
RECEPTIONIST_AGENT_NAME=receptionist

# Netelip -> LiveKit inbound telephony (optional).
# The DID must be E.164. Find the SIP endpoint in LiveKit Cloud project
# settings; it is not necessarily the same hostname as LIVEKIT_URL.
# NETELIP_DID=+576011234567
# LIVEKIT_SIP_ENDPOINT=your-project-id.sip.livekit.cloud
# Confirm current ingress IPs with Netelip before production. Multiple
# addresses are comma-separated. This value is Netelip's published LATAM
# SIP address at the time this integration was added.
# NETELIP_ALLOWED_ADDRESSES=192.99.91.144/32
# NETELIP_SECURITY_MODE=auto
# NETELIP_SIP_USERNAME=your-netelip-sip-user
# NETELIP_SIP_PASSWORD=your-netelip-sip-password

# Required when voice.provider is "google" (the example-dental default).
# Create the key in Google AI Studio; never commit a real key.
GOOGLE_API_KEY=your-google-api-key

# Required only for businesses that use voice.provider: "openai".
OPENAI_API_KEY=your-openai-api-key

# EspoCRM. Prefer an API user/key in production. Basic auth is included only
# for the local demo configuration.
ESPOCRM_API_KEY=your-espocrm-api-key
ESPOCRM_USERNAME=admin
ESPOCRM_PASSWORD=your-espocrm-password

# --------------------------------------------------------------------------
# Optional variables — only needed if you enable the corresponding feature
# in a business's YAML config. These are referenced via ${VAR} interpolation.
# --------------------------------------------------------------------------

# SMTP email sender (referenced by email.sender.smtp.*)
# SMTP_USERNAME=receptionist@acmedental.com
# SMTP_PASSWORD=your-smtp-app-password

# Resend email sender (referenced by email.sender.resend.api_key)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EXAMPLE_RESEND_API_KEY=re_xxxxxxxxxxxx        # used by example-workers-comp.yaml

# S3-compatible recording storage (LiveKit Egress reads AWS creds from env)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Example: Slack webhook header used in a webhook channel's headers block
# SLACK_TOKEN=xoxb-your-token

# --------------------------------------------------------------------------
# Google Calendar integration: credentials live in secrets/<business>/, NOT in
# env vars. See documentation/google-calendar-setup.md.
# No new env vars are required for calendar — the .env file is unaffected.
# --------------------------------------------------------------------------
